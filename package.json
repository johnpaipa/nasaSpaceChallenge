{
  "name": "space-mission-designer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NASA Space Apps - Space Mission Design Game (monolito: Vite + React + Three.js + Express + Socket.io)",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test shared/*.test.js client/src/*.test.js client/src/explore/*.test.js",
    "i18n:check": "node scripts/i18n-extract.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "geotiff": "^3.0.5",
    "puppeteer-core": "^25.16.0",
    "vite": "^8.3.5"
  }
}
